---
import { getCollection } from "astro:content";
import ProjectDetailPage from "@/components/pages/ProjectDetailPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((project) => project.data.locale === "en").sort((a, b) => Number(b.data.year) - Number(a.data.year));
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, previousProject: projects[index - 1], nextProject: projects[index + 1] },
  }));
}

const { project } = Astro.props;
const projects = (await getCollection("projects")).filter((item) => item.data.locale === "en").sort((a, b) => Number(b.data.year) - Number(a.data.year));
const currentIndex = projects.findIndex((item) => item.data.slug === project.data.slug);
---

<BaseLayout title={`${project.data.title} - Roubil Ridlo`} description={project.data.summary} image={project.data.coverImage} type="article">
  <ProjectDetailPage project={project} previousProject={projects[currentIndex - 1]} nextProject={projects[currentIndex + 1]} />
</BaseLayout>
