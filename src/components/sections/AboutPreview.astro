---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { t } from "@/i18n/translations";
import { getLocale, localizedPath } from "@/i18n/utils";

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---

<section class="section-padding">
  <div class="container-page grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-start">
    <div>
      <p class="badge">{copy.sections.aboutBadge}</p>
      <h2 class="mt-4 text-3xl font-black tracking-[0] md:text-4xl">{copy.sections.aboutTitle}</h2>
    </div>
    <div>
      <p class="leading-8 text-muted">
        {copy.sections.aboutDescription}
      </p>
      <p class="mt-4 leading-8 text-muted">
        {copy.sections.aboutDescription2}
      </p>
      <div class="mt-6">
        <ButtonLink href={localizedPath(locale, "about")} variant="secondary">{copy.sections.readMore}</ButtonLink>
      </div>
    </div>
  </div>
</section>
